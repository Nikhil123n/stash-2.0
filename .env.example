DISCORD_TOKEN=
STASH_OWNER_ID=
STASH_ENV=production
GROQ_API_KEY=              # agent + categorizer, primary provider (Groq)
OPENROUTER_API_KEY=        # agent + categorizer, fallback provider + vision (OpenRouter)
SANDBOX_FILE=./sandbox_data.json
FFMPEG_LOCATION=           # optional: path to ffmpeg/ffprobe binaries if not on PATH

# mymind auth — cookie-based (ACTIVE on main, zero mymind credits)
# From scripts/export_cookies.py, after running `mymind login` locally:
MYMIND_JWT=
MYMIND_CID=
MYMIND_AUTHENTICITY_TOKEN=
# For local Windows run: leave the three above empty, bot uses keyring automatically

# mymind auth — JWT-key-based (approach/jwt branch ONLY — not read by main)
# MYMIND_KID=
# MYMIND_SECRET=
